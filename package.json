{
  "name": "ssl-commerz-kam-admin-panel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "env:uat": "node scripts/prepare-env.mjs uat",
    "env:uat:build": "node scripts/prepare-env.mjs uat-build",
    "env:local": "node scripts/prepare-env.mjs local",
    "dev": "npm run env:uat && vite",
    "dev:local": "npm run env:local && vite",
    "build": "npm run env:uat:build && npx vite build --configLoader native && npm run export:build -- uat",
    "build:local": "npm run env:local && vite build && npm run export:build -- local",
    "build:to": "npm run env:uat:build && vite build && node scripts/export-build.mjs uat",
    "build:local:to": "npm run env:local && vite build && node scripts/export-build.mjs local",
    "export:build": "node scripts/export-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "@types/three": "^0.183.1",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.183.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
